{
  "name": "dsh-speech-multi",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "dsh": ">=0.2.2-rc.1 <=0.5.0"
  },
  "type": "module",
  "description": "Four local speech-to-text models with per-model chunking, device tiers, and a soft/hard selection lock.",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./worker": {
      "types": "./lib/worker/entry.d.ts",
      "default": "./lib/worker/entry.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.js.map",
    "runtime/assets.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "onnxruntime-web": "^1.31.1",
    "sherpa-onnx-node": "1.13.8",
    "tokenizers": "^0.23.2",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.2-rc.1 <=0.5.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-experimental-speech-to-text": "0.2.2-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
